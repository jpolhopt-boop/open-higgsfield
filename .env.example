# Platform key as key-id:key-secret. Server only; put it in .env.local, never commit it.
# Optional: a key added in the studio (cookie) takes priority over this one.
HF_CREDENTIALS=
# Required when the app is published (PWA/Vercel): every page and API route then
# asks for this password (HTTP Basic, any user name). Unset = no gate, for localhost only.
APP_PASSWORD=
# Optional. Defaults to https://api.higgsfield.ai
HF_API_BASE_URL=
# Optional. Without it, uploads go through the platform's own presigned upload.
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=
